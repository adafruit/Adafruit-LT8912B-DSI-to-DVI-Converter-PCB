&lt;td&gt;665pF @ 15V&lt;/td&gt;
&lt;td&gt;SI7308DN-T1-E3CT-ND&lt;/td&gt;
&lt;/tr&gt;

&lt;/table&gt;
&lt;/p&gt;</description>
