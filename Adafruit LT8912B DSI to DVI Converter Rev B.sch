&lt;td&gt;VGS(TH)&lt;/td&gt;
&lt;td&gt;CISS&lt;/td&gt;
&lt;td&gt;Order Number&lt;/td&gt;
&lt;/tr&gt;

&lt;tr&gt;
&lt;td&gt;Si7308DN&lt;/td&gt;
&lt;td&gt;60V&lt;/td&gt;
&lt;td&gt;6A&lt;/td&gt;
&lt;td&gt;58 mOhm&lt;/td&gt;
