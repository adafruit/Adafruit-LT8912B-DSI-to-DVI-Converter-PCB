<deviceset name="TPD4E05U06" prefix="U" uservalue="yes">
<description>Genuine Texas Instruments TPD4E05U06DQAR, C138714. Four 5.5 V ESD channels, 0.5 pF typical; HDMI application in SLVSBO7O p.13. GND maps to pads 3 and 8 with route=all. Pads 6,7,9,10 are internally NC but used for PCB pass-through routing per TI SLVSBO7O pp.4/17. Signal pairs 1-10, 2-9, 4-7, 5-6 use route=all and must be joined by PCB traces; they are not internally connected. Place beside the connector with short signal and ground paths.</description>
<gates>
<gate name="G$1" symbol="TPD4E05U06" x="0" y="0"/>
</gates>
<devices>
<device name="" package="USON10_1X2.5_P05_TPD4E05U06">
<connects>
<connect gate="G$1" pin="D1+" pad="1 10"/>
<connect gate="G$1" pin="D1-" pad="2 9"/>
<connect gate="G$1" pin="D2+" pad="4 7"/>
<connect gate="G$1" pin="D2-" pad="5 6"/>
<connect gate="G$1" pin="GND" pad="3 8"/>
</connects>
<technologies>
<technology name="">
<attribute name="LCSC" value="C138714" constant="no"/>
<attribute name="MANUFACTURER" value="Texas Instruments" constant="no"/>
